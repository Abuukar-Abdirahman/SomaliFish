# Copy this file to .env and fill in your own token.
#   cp .env.example .env
#
# .env is gitignored. Never commit a real token.

# Global Fishing Watch API token - free, from
# https://globalfishingwatch.org/our-apis/
# Request "Research / Academic (non-commercial)" access.
# Needed only to download fishing-effort LABELS (src/download_gfw.py).
# You do NOT need this to run the map or the demo.
GFW_API_TOKEN=<paste-your-token-here>

# Copernicus Marine credentials are NOT stored here. That library keeps its
# own config file, created once by:
#     copernicusmarine login
# which writes to ~/.copernicusmarine/.copernicusmarine-credentials
